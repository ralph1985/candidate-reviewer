---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout activeNav="challenges" title="Enunciados de ejercicios" description="Listado de pruebas técnicas cargadas para validar cobertura de requisitos">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-slate-900">Ejercicios disponibles</h3>
      <button class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="refresh-challenges" type="button">Refrescar</button>
    </div>
    <p class="mt-2 text-xs text-slate-500">Estos enunciados se usan para detectar la prueba del candidato y evaluar si cubre los requisitos.</p>
    <div class="mt-4 space-y-3" id="challenges-list">
      <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-500">Cargando enunciados...</div>
    </div>
  </section>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;
    const refreshBtn = document.getElementById('refresh-challenges');
    const challengesList = document.getElementById('challenges-list');
    const markedModulePromise = import('https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js');

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function normalizeMarkdown(content) {
      let value = String(content || '');
      value = value.replace(/^---[\s\S]*?\n---\n?/m, '');
      value = value.replace(/{%[^%]*%}/g, '');
      value = value.replace(/{{[^}]*}}/g, '');
      value = value.replace(/\n{3,}/g, '\n\n').trim();
      return value;
    }

    async function loadChallenges() {
      challengesList.innerHTML = '<div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-500">Cargando enunciados...</div>';
      try {
        const response = await fetch(`${apiBase}/api/challenges`);
        if (!response.ok) throw new Error('No se pudieron cargar enunciados');
        const data = await response.json();
        const { marked } = await markedModulePromise;

        if (!Array.isArray(data) || data.length === 0) {
          challengesList.innerHTML = '<div class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-500">No hay enunciados cargados.</div>';
          return;
        }

        challengesList.innerHTML = data.map((challenge) => {
          const content = normalizeMarkdown(challenge.content || '');
          const html = marked.parse(content, { gfm: true, breaks: true });
          return `
            <details class="group rounded-xl border border-slate-200 bg-white p-0">
              <summary class="cursor-pointer list-none px-4 py-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <div class="text-sm font-semibold text-slate-900">${escapeHtml(challenge.name || challenge.key || 'Ejercicio')}</div>
                    <div class="text-xs text-slate-500">key: ${escapeHtml(challenge.key || '-')}</div>
                  </div>
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">ver enunciado</span>
                </div>
              </summary>
              <div class="border-t border-slate-200 px-4 py-3">
                <article class="[&_h1]:mb-3 [&_h1]:text-xl [&_h1]:font-semibold [&_h2]:mb-2 [&_h2]:mt-5 [&_h2]:text-lg [&_h2]:font-semibold [&_h3]:mb-2 [&_h3]:mt-4 [&_h3]:text-base [&_h3]:font-semibold [&_p]:mb-3 [&_p]:leading-relaxed [&_ul]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:mb-3 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_blockquote]:my-3 [&_blockquote]:border-l-4 [&_blockquote]:border-blue-200 [&_blockquote]:bg-blue-50 [&_blockquote]:px-3 [&_blockquote]:py-2 [&_table]:mb-3 [&_table]:w-full [&_table]:border-collapse [&_th]:border [&_th]:border-slate-300 [&_th]:bg-slate-100 [&_th]:px-2 [&_th]:py-1 [&_th]:text-left [&_td]:border [&_td]:border-slate-200 [&_td]:px-2 [&_td]:py-1 [&_code]:rounded [&_code]:bg-slate-100 [&_code]:px-1 [&_code]:py-0.5 [&_pre]:mb-3 [&_pre]:overflow-auto [&_pre]:rounded-lg [&_pre]:bg-slate-950 [&_pre]:p-3 [&_pre]:text-xs [&_pre]:text-slate-100 [&_a]:text-blue-700 [&_a]:underline">${html || '<p>-</p>'}</article>
                <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
                  <summary class="cursor-pointer text-xs font-medium text-slate-700">Ver markdown original</summary>
                  <pre class="mt-2 max-h-56 overflow-auto whitespace-pre-wrap text-xs text-slate-700">${escapeHtml(content || '-')}</pre>
                </details>
              </div>
            </details>
          `;
        }).join('');
      } catch {
        challengesList.innerHTML = '<div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs text-rose-700">Error cargando enunciados.</div>';
      }
    }

    refreshBtn.addEventListener('click', () => {
      void loadChallenges();
    });

    void loadChallenges();
  </script>
</AppLayout>
