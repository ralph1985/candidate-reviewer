---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout activeNav="skills" title="Skills de revisión" description="Cada skill define una fase y su prompt enviado a Codex">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-slate-900">Listado de skills</h3>
      <div class="flex flex-wrap gap-2">
        <button class="rounded-lg bg-blue-700 px-3 py-2 text-sm font-medium text-white" id="new-skill" type="button">Nueva skill</button>
        <button class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="refresh-skills" type="button">Refrescar</button>
      </div>
    </div>

    <div class="mt-3 overflow-auto">
      <table class="min-w-full border-collapse text-sm">
        <thead>
          <tr class="text-left text-slate-600">
            <th class="border-b border-slate-200 px-2 py-2">ID</th>
            <th class="border-b border-slate-200 px-2 py-2">Key</th>
            <th class="border-b border-slate-200 px-2 py-2">Nombre</th>
            <th class="border-b border-slate-200 px-2 py-2">Activa</th>
            <th class="border-b border-slate-200 px-2 py-2">Orden</th>
            <th class="border-b border-slate-200 px-2 py-2">Acción</th>
          </tr>
        </thead>
        <tbody id="skills-body"></tbody>
      </table>
    </div>
  </section>

  <div class="fixed inset-0 z-40 hidden" id="skill-modal" aria-hidden="true">
    <div class="absolute inset-0 bg-slate-950/45" id="skill-modal-backdrop"></div>
    <section class="absolute right-0 top-0 h-full w-full max-w-2xl overflow-y-auto border-l border-slate-200 bg-white p-5 shadow-2xl">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-slate-900" id="skill-modal-title">Nueva skill</h3>
          <p class="text-sm text-slate-500">Define el prompt y orden de ejecución de la fase.</p>
        </div>
        <button class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="close-skill-modal" type="button">Cerrar</button>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="skill-id" type="number" min="1" placeholder="ID (auto en alta)" readonly />
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="skill-key" placeholder="key (ej: architecture)" />
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="skill-name" placeholder="Nombre" />
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="skill-sort-order" type="number" placeholder="Orden (10,20,30...)" />
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm md:col-span-2" id="skill-description" placeholder="Descripción" />
      </div>
      <textarea class="mt-3 min-h-56 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="skill-prompt-template" placeholder="Prompt template"></textarea>
      <label class="mt-3 inline-flex items-center gap-2 text-sm text-slate-700">
        <input id="skill-active" type="checkbox" checked />
        Activa
      </label>

      <div class="mt-4 flex flex-wrap gap-2">
        <button class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white" id="save-skill" type="button">Guardar skill</button>
        <button class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-800" id="clear-skill-form" type="button">Limpiar</button>
        <button class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-800" id="cancel-skill-edit" type="button">Cancelar</button>
      </div>
      <p class="mt-2 text-xs text-slate-500" id="skill-msg"></p>
    </section>
  </div>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;
    const skillsBody = document.getElementById('skills-body');
    const refreshSkillsBtn = document.getElementById('refresh-skills');
    const newSkillBtn = document.getElementById('new-skill');

    const skillModal = document.getElementById('skill-modal');
    const skillModalBackdrop = document.getElementById('skill-modal-backdrop');
    const closeSkillModalBtn = document.getElementById('close-skill-modal');
    const cancelSkillEditBtn = document.getElementById('cancel-skill-edit');
    const skillModalTitle = document.getElementById('skill-modal-title');

    const skillId = document.getElementById('skill-id');
    const skillKey = document.getElementById('skill-key');
    const skillName = document.getElementById('skill-name');
    const skillSortOrder = document.getElementById('skill-sort-order');
    const skillDescription = document.getElementById('skill-description');
    const skillPromptTemplate = document.getElementById('skill-prompt-template');
    const skillActive = document.getElementById('skill-active');
    const saveSkillBtn = document.getElementById('save-skill');
    const clearSkillFormBtn = document.getElementById('clear-skill-form');
    const skillMsg = document.getElementById('skill-msg');

    let cachedSkills = [];

    function setModalOpen(open) {
      if (!skillModal) return;
      skillModal.classList.toggle('hidden', !open);
      skillModal.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('overflow-hidden', open);
    }

    function clearSkillForm() {
      skillId.value = '';
      skillKey.value = '';
      skillName.value = '';
      skillSortOrder.value = '';
      skillDescription.value = '';
      skillPromptTemplate.value = '';
      skillActive.checked = true;
    }

    function fillSkillForm(skill) {
      skillId.value = String(skill.id);
      skillKey.value = skill.key || '';
      skillName.value = skill.name || '';
      skillSortOrder.value = String(skill.sort_order ?? '');
      skillDescription.value = skill.description || '';
      skillPromptTemplate.value = skill.prompt_template || '';
      skillActive.checked = Boolean(skill.active);
    }

    function openCreateSkill() {
      clearSkillForm();
      if (skillModalTitle) skillModalTitle.textContent = 'Nueva skill';
      skillMsg.textContent = '';
      setModalOpen(true);
    }

    function openEditSkill(skill) {
      fillSkillForm(skill);
      if (skillModalTitle) skillModalTitle.textContent = `Editar skill #${skill.id}`;
      skillMsg.textContent = `Skill #${skill.id} cargada para edición.`;
      setModalOpen(true);
    }

    async function loadSkills() {
      skillsBody.innerHTML = '<tr><td colspan="6" class="px-2 py-2 text-xs text-slate-500">Cargando skills...</td></tr>';
      try {
        const response = await fetch(`${apiBase}/api/skills`);
        if (!response.ok) throw new Error('No se pudieron cargar skills');

        const data = await response.json();
        cachedSkills = data;

        if (!data.length) {
          skillsBody.innerHTML = '<tr><td colspan="6" class="px-2 py-2 text-xs text-slate-500">Sin skills todavía.</td></tr>';
          return;
        }

        skillsBody.innerHTML = data.map((skill) => `
          <tr class="align-top hover:bg-slate-50/70">
            <td class="border-b border-slate-200 px-2 py-2">${skill.id}</td>
            <td class="border-b border-slate-200 px-2 py-2">${skill.key}</td>
            <td class="border-b border-slate-200 px-2 py-2">${skill.name}</td>
            <td class="border-b border-slate-200 px-2 py-2">${skill.active ? 'sí' : 'no'}</td>
            <td class="border-b border-slate-200 px-2 py-2">${skill.sort_order}</td>
            <td class="border-b border-slate-200 px-2 py-2">
              <button class="rounded bg-slate-100 px-2 py-1 text-xs hover:bg-slate-200" data-edit-skill="${skill.id}" type="button">Editar</button>
            </td>
          </tr>
        `).join('');
      } catch {
        skillsBody.innerHTML = '<tr><td colspan="6" class="px-2 py-2 text-xs text-slate-500">Error cargando skills.</td></tr>';
      }
    }

    skillsBody.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const button = target.closest('button[data-edit-skill]');
      if (!button) return;
      const id = Number(button.getAttribute('data-edit-skill'));
      const skill = cachedSkills.find((entry) => Number(entry.id) === id);
      if (!skill) return;
      openEditSkill(skill);
    });

    refreshSkillsBtn.addEventListener('click', loadSkills);
    newSkillBtn.addEventListener('click', openCreateSkill);

    closeSkillModalBtn.addEventListener('click', () => setModalOpen(false));
    cancelSkillEditBtn.addEventListener('click', () => setModalOpen(false));
    skillModalBackdrop.addEventListener('click', () => setModalOpen(false));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setModalOpen(false);
    });

    saveSkillBtn.addEventListener('click', async () => {
      const payload = {
        key: skillKey.value.trim(),
        name: skillName.value.trim(),
        description: skillDescription.value.trim(),
        promptTemplate: skillPromptTemplate.value.trim(),
        active: skillActive.checked,
        sortOrder: skillSortOrder.value ? Number(skillSortOrder.value) : undefined
      };

      if (!payload.key || !payload.name || !payload.promptTemplate) {
        skillMsg.textContent = 'Key, nombre y prompt son obligatorios.';
        return;
      }

      const id = Number(skillId.value);
      const isUpdate = Number.isInteger(id) && id > 0;
      const endpoint = isUpdate ? `${apiBase}/api/skills/${id}` : `${apiBase}/api/skills`;
      const method = isUpdate ? 'PATCH' : 'POST';

      skillMsg.textContent = 'Guardando skill...';
      const response = await fetch(endpoint, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!response.ok) {
        const error = await response.json().catch(() => ({}));
        skillMsg.textContent = error.error || 'No se pudo guardar la skill.';
        return;
      }

      const saved = await response.json();
      skillMsg.textContent = `Skill #${saved.id} guardada correctamente.`;
      fillSkillForm(saved);
      await loadSkills();
      setTimeout(() => setModalOpen(false), 450);
    });

    clearSkillFormBtn.addEventListener('click', () => {
      clearSkillForm();
      skillMsg.textContent = '';
    });

    loadSkills();
  </script>
</AppLayout>
