---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout activeNav="new" title="Nueva revisión" description="Alta manual de candidato y repositorio GitHub">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <form class="grid grid-cols-1 gap-3 md:grid-cols-[1fr_1fr_auto]" id="create-form">
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="candidate-name" placeholder="Nombre candidato" required />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="github-url" type="url" placeholder="https://github.com/org/repo" required />
      <button class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white" type="submit">Crear</button>
    </form>
    <p class="mt-3 text-xs text-slate-500" id="create-msg"></p>
  </section>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;
    const createForm = document.getElementById('create-form');
    const createMsg = document.getElementById('create-msg');

    createForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const candidateName = document.getElementById('candidate-name').value.trim();
      const githubUrl = document.getElementById('github-url').value.trim();

      createMsg.textContent = 'Guardando...';
      const response = await fetch(`${apiBase}/api/reviews`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ candidateName, githubUrl })
      });

      if (!response.ok) {
        createMsg.textContent = 'No se pudo crear la revisión.';
        return;
      }

      const created = await response.json();
      createMsg.textContent = `Revisión #${created.id} creada. Redirigiendo a detalle...`;
      createForm.reset();
      window.location.href = `${appBase}/reviews/detail?id=${created.id}`;
    });
  </script>
</AppLayout>

