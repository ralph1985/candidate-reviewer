---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout activeNav="reviews" title="Revisiones" description="Listado general, lanzamiento de IA y acceso a detalle">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-base font-semibold text-slate-900">Listado de revisiones</h3>
      <div class="flex items-center gap-2">
        <button class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="refresh" type="button">Refrescar</button>
        <button class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="toggle-auto-refresh" type="button">Auto: ON</button>
      </div>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-slate-200 px-2 py-0.5 font-semibold text-slate-700" id="auto-refresh-state">Auto-refresh activo</span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600" id="auto-refresh-interval">Intervalo: 10s</span>
      <span class="text-slate-500" id="last-refresh-at">Última actualización: -</span>
    </div>
    <div class="mt-3 overflow-auto">
      <table class="min-w-full border-collapse text-sm">
        <thead>
          <tr class="text-left text-slate-600">
            <th class="border-b border-slate-200 px-2 py-2">ID</th>
            <th class="border-b border-slate-200 px-2 py-2">Candidato</th>
            <th class="border-b border-slate-200 px-2 py-2">Repositorio</th>
            <th class="border-b border-slate-200 px-2 py-2">Estado</th>
            <th class="border-b border-slate-200 px-2 py-2">Recomendación</th>
            <th class="border-b border-slate-200 px-2 py-2">Creado</th>
            <th class="border-b border-slate-200 px-2 py-2">Acción</th>
          </tr>
        </thead>
        <tbody id="reviews-body"></tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-slate-500" id="list-msg"></p>
  </section>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;
    const reviewsBody = document.getElementById('reviews-body');
    const refreshBtn = document.getElementById('refresh');
    const toggleAutoRefreshBtn = document.getElementById('toggle-auto-refresh');
    const autoRefreshState = document.getElementById('auto-refresh-state');
    const autoRefreshInterval = document.getElementById('auto-refresh-interval');
    const lastRefreshAt = document.getElementById('last-refresh-at');
    const listMsg = document.getElementById('list-msg');
    const fmtDate = (value) => (value ? new Date(value).toLocaleString('es-ES') : '-');
    const FAST_POLL_MS = 3000;
    const IDLE_POLL_MS = 10000;
    let autoRefreshEnabled = true;
    let pollTimer = null;
    let currentIntervalMs = IDLE_POLL_MS;

    function setLastRefreshNow() {
      lastRefreshAt.textContent = `Última actualización: ${new Date().toLocaleTimeString()}`;
    }

    function renderAutoRefreshUi() {
      toggleAutoRefreshBtn.textContent = `Auto: ${autoRefreshEnabled ? 'ON' : 'OFF'}`;
      autoRefreshState.className = autoRefreshEnabled
        ? 'rounded-full bg-emerald-100 px-2 py-0.5 font-semibold text-emerald-800'
        : 'rounded-full bg-slate-200 px-2 py-0.5 font-semibold text-slate-700';
      autoRefreshState.textContent = autoRefreshEnabled ? 'Auto-refresh activo' : 'Auto-refresh pausado';
      autoRefreshInterval.textContent = `Intervalo: ${Math.round(currentIntervalMs / 1000)}s`;
    }

    function restartPolling() {
      if (pollTimer) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
      if (!autoRefreshEnabled) return;
      pollTimer = window.setInterval(() => {
        void loadReviews({ silent: true });
      }, currentIntervalMs);
    }

    async function loadReviews(options = { silent: false }) {
      if (!options.silent) {
        reviewsBody.innerHTML = '<tr><td colspan="7" class="px-2 py-2 text-xs text-slate-500">Cargando...</td></tr>';
      }
      try {
        const response = await fetch(`${apiBase}/api/reviews`);
        if (!response.ok) throw new Error('No se pudo cargar revisiones');
        const data = await response.json();
        const hasRunning = data.some((review) => review.status === 'running');
        const nextIntervalMs = hasRunning ? FAST_POLL_MS : IDLE_POLL_MS;
        if (nextIntervalMs !== currentIntervalMs) {
          currentIntervalMs = nextIntervalMs;
          renderAutoRefreshUi();
          restartPolling();
        }

        if (!data.length) {
          reviewsBody.innerHTML = '<tr><td colspan="7" class="px-2 py-2 text-xs text-slate-500">Sin revisiones todavía.</td></tr>';
          setLastRefreshNow();
          return;
        }

        reviewsBody.innerHTML = data.map((review) => `
          <tr class="align-top">
            <td class="border-b border-slate-200 px-2 py-2">${review.id}</td>
            <td class="border-b border-slate-200 px-2 py-2">${review.candidate_name}</td>
            <td class="border-b border-slate-200 px-2 py-2"><a class="text-blue-700 underline" href="${review.github_url}" target="_blank" rel="noreferrer">repo</a></td>
            <td class="border-b border-slate-200 px-2 py-2"><span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs">${review.status}</span></td>
            <td class="border-b border-slate-200 px-2 py-2">${review.recommendation}</td>
            <td class="border-b border-slate-200 px-2 py-2">${fmtDate(review.created_at)}</td>
            <td class="border-b border-slate-200 px-2 py-2">
              <button class="mr-1 rounded bg-slate-100 px-2 py-1 text-xs" data-open="${review.id}" type="button">Detalle</button>
              <button
                class="rounded px-2 py-1 text-xs text-white ${review.status === 'running' || hasRunning ? 'cursor-not-allowed bg-slate-400' : 'bg-blue-700'}"
                data-run="${review.id}"
                data-status="${review.status}"
                type="button"
                ${review.status === 'running' || hasRunning ? 'disabled' : ''}
              >${review.status === 'running' ? 'En progreso' : (hasRunning ? 'Bloqueado' : 'Run IA')}</button>
            </td>
          </tr>
        `).join('');

        for (const btn of reviewsBody.querySelectorAll('button[data-open]')) {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-open'));
            window.location.href = `${appBase}/reviews/detail?id=${id}`;
          });
        }

        for (const btn of reviewsBody.querySelectorAll('button[data-run]')) {
          btn.addEventListener('click', async () => {
            const id = Number(btn.getAttribute('data-run'));
            const status = btn.getAttribute('data-status');
            if (status === 'running' || hasRunning) {
              listMsg.textContent = 'Solo se permite una revisión IA en ejecución a la vez.';
              return;
            }
            btn.setAttribute('disabled', 'disabled');
            btn.classList.remove('bg-blue-700');
            btn.classList.add('bg-slate-400', 'cursor-not-allowed');
            btn.textContent = 'En progreso';
            listMsg.textContent = `Lanzando revisión #${id}...`;
            const response = await fetch(`${apiBase}/api/reviews/${id}/run`, { method: 'POST' });
            if (!response.ok) {
              let errorText = `No se pudo lanzar la revisión #${id}.`;
              if (response.status === 409) {
                try {
                  const body = await response.json();
                  errorText = body?.error || 'Solo se permite una revisión IA en ejecución a la vez.';
                } catch {
                  errorText = 'Solo se permite una revisión IA en ejecución a la vez.';
                }
              }
              listMsg.textContent = errorText;
              btn.removeAttribute('disabled');
              btn.classList.remove('bg-slate-400', 'cursor-not-allowed');
              btn.classList.add('bg-blue-700');
              btn.textContent = 'Run IA';
              return;
            }
            listMsg.textContent = `Revisión #${id} lanzada en background. Seguimiento automático activo.`;
            currentIntervalMs = FAST_POLL_MS;
            renderAutoRefreshUi();
            restartPolling();
            await loadReviews({ silent: true });
          });
        }
        setLastRefreshNow();
      } catch {
        reviewsBody.innerHTML = '<tr><td colspan="7" class="px-2 py-2 text-xs text-slate-500">Error cargando revisiones.</td></tr>';
      }
    }

    refreshBtn.addEventListener('click', () => {
      void loadReviews();
    });
    toggleAutoRefreshBtn.addEventListener('click', () => {
      autoRefreshEnabled = !autoRefreshEnabled;
      renderAutoRefreshUi();
      restartPolling();
    });
    renderAutoRefreshUi();
    void loadReviews();
    restartPolling();
  </script>
</AppLayout>
