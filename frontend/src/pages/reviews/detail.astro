---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout activeNav="detail" title="Detalle de revisión" description="Actualiza una revisión y consulta el resultado por fases">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-[220px_auto]">
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-id" type="number" min="1" placeholder="ID revisión" />
      <button class="w-fit rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="load-review" type="button">Cargar revisión</button>
    </div>

    <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-candidate-name" placeholder="Candidato" />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-github-url" placeholder="URL repositorio" />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-deploy-url" placeholder="URL despliegue" />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-exercise-name" placeholder="Ejercicio" />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-reviewer-name" placeholder="Evaluador" />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-reviewer-email" placeholder="Email evaluador" />
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm md:col-span-2" id="edit-reviewed-at" type="datetime-local" />
      <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-status">
        <option value="pending">pending</option>
        <option value="running">running</option>
        <option value="done">done</option>
        <option value="failed">failed</option>
      </select>
      <select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-recommendation">
        <option value="pendiente">pendiente</option>
        <option value="apto">apto</option>
        <option value="no_apto">no_apto</option>
      </select>
      <input class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm md:col-span-2" id="edit-scores" placeholder='{"arquitectura": 8, "tests": 7}' />
    </div>

    <textarea class="mt-3 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-intake-conclusions" placeholder="Conclusiones"></textarea>
    <textarea class="mt-3 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-predefined-questions" placeholder="Preguntas predefinidas (una por línea)"></textarea>
    <textarea class="mt-3 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-other-questions" placeholder="Otras preguntas para entrevista"></textarea>
    <textarea class="mt-3 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-good-practices" placeholder="Buenas prácticas"></textarea>
    <textarea class="mt-3 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-design-patterns" placeholder="Patrones de diseño y arquitectura"></textarea>
    <textarea class="mt-3 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-report" placeholder="Informe final"></textarea>
    <div class="mt-3 flex flex-wrap gap-2">
      <button class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white" id="save-review" type="button">Guardar cambios</button>
      <button class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-800" id="run-review" type="button">Run IA</button>
      <button class="rounded-lg bg-rose-700 px-4 py-2 text-sm font-medium text-white" id="clear-form" type="button">Limpiar</button>
    </div>
    <p class="mt-2 text-xs text-slate-500" id="edit-msg"></p>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <h3 class="text-sm font-semibold text-slate-900">Fases revisadas</h3>
    <div class="mt-2 text-xs text-slate-500" id="phase-list">Selecciona una revisión para ver fases.</div>
  </section>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;

    const editId = document.getElementById('edit-id');
    const loadReviewBtn = document.getElementById('load-review');
    const editCandidateName = document.getElementById('edit-candidate-name');
    const editGithubUrl = document.getElementById('edit-github-url');
    const editDeployUrl = document.getElementById('edit-deploy-url');
    const editExerciseName = document.getElementById('edit-exercise-name');
    const editReviewerName = document.getElementById('edit-reviewer-name');
    const editReviewerEmail = document.getElementById('edit-reviewer-email');
    const editReviewedAt = document.getElementById('edit-reviewed-at');
    const editStatus = document.getElementById('edit-status');
    const editRecommendation = document.getElementById('edit-recommendation');
    const editScores = document.getElementById('edit-scores');
    const editIntakeConclusions = document.getElementById('edit-intake-conclusions');
    const editPredefinedQuestions = document.getElementById('edit-predefined-questions');
    const editOtherQuestions = document.getElementById('edit-other-questions');
    const editGoodPractices = document.getElementById('edit-good-practices');
    const editDesignPatterns = document.getElementById('edit-design-patterns');
    const editReport = document.getElementById('edit-report');
    const saveReviewBtn = document.getElementById('save-review');
    const runReviewBtn = document.getElementById('run-review');
    const clearFormBtn = document.getElementById('clear-form');
    const editMsg = document.getElementById('edit-msg');
    const phaseList = document.getElementById('phase-list');

    async function loadPhases(id) {
      phaseList.textContent = 'Cargando fases...';
      try {
        const response = await fetch(`${apiBase}/api/reviews/${id}/phases`);
        if (!response.ok) throw new Error('No se pudieron cargar fases');
        const phases = await response.json();
        if (!phases.length) {
          phaseList.textContent = 'Sin fases registradas todavía.';
          return;
        }
        phaseList.innerHTML = phases.map((phase) => `
          <div class="mb-2 rounded-lg border border-slate-200 bg-slate-50 p-3">
            <div class="text-sm font-semibold text-slate-900">${phase.phase_key} · <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-normal">${phase.status}</span> · score: ${phase.score ?? '-'}</div>
            <div class="mt-1 text-xs text-slate-600">${phase.summary || '-'}</div>
          </div>
        `).join('');
      } catch {
        phaseList.textContent = 'Error cargando fases.';
      }
    }

    async function loadReview(id) {
      editMsg.textContent = `Cargando revisión #${id}...`;
      const response = await fetch(`${apiBase}/api/reviews/${id}`);
      if (!response.ok) {
        editMsg.textContent = `No se encontró la revisión #${id}.`;
        return;
      }
      const detail = await response.json();
      editId.value = String(detail.id);
      editCandidateName.value = detail.candidate_name || '';
      editGithubUrl.value = detail.github_url || '';
      editDeployUrl.value = detail.candidate_deploy_url || '';
      editExerciseName.value = detail.exercise_name || '';
      editReviewerName.value = detail.reviewer_name || '';
      editReviewerEmail.value = detail.reviewer_email || '';
      editReviewedAt.value = detail.reviewed_at ? new Date(detail.reviewed_at).toISOString().slice(0, 16) : '';
      editStatus.value = detail.status;
      editRecommendation.value = detail.recommendation;
      editScores.value = detail.scores ? JSON.stringify(detail.scores) : '';
      editIntakeConclusions.value = detail.intake_conclusions || '';
      editPredefinedQuestions.value = Array.isArray(detail.predefined_questions) ? detail.predefined_questions.join('\n') : '';
      editOtherQuestions.value = detail.intake_other_questions || '';
      editGoodPractices.value = detail.intake_good_practices || '';
      editDesignPatterns.value = detail.intake_design_patterns || '';
      editReport.value = detail.final_report || '';
      editMsg.textContent = `Revisión #${id} cargada.`;
      await loadPhases(id);
      const url = new URL(window.location.href);
      url.searchParams.set('id', String(id));
      window.history.replaceState(null, '', url.toString());
    }

    loadReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }
      await loadReview(id);
    });

    saveReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }

      let parsedScores = null;
      if (editScores.value.trim()) {
        try {
          parsedScores = JSON.parse(editScores.value);
        } catch {
          editMsg.textContent = 'Scores no es JSON válido.';
          return;
        }
      }

      editMsg.textContent = 'Guardando cambios...';
      const response = await fetch(`${apiBase}/api/reviews/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          candidateName: editCandidateName.value.trim(),
          githubUrl: editGithubUrl.value.trim(),
          deployUrl: editDeployUrl.value.trim(),
          exerciseName: editExerciseName.value.trim(),
          reviewerName: editReviewerName.value.trim(),
          reviewerEmail: editReviewerEmail.value.trim(),
          reviewedAt: editReviewedAt.value.trim(),
          intakeConclusions: editIntakeConclusions.value.trim(),
          predefinedQuestions: editPredefinedQuestions.value
            .split('\n')
            .map((line) => line.trim())
            .filter(Boolean),
          intakeOtherQuestions: editOtherQuestions.value.trim(),
          intakeGoodPractices: editGoodPractices.value.trim(),
          intakeDesignPatterns: editDesignPatterns.value.trim(),
          status: editStatus.value,
          recommendation: editRecommendation.value,
          scores: parsedScores,
          finalReport: editReport.value
        })
      });

      if (!response.ok) {
        editMsg.textContent = 'No se pudo actualizar la revisión.';
        return;
      }

      editMsg.textContent = `Revisión #${id} actualizada.`;
      await loadPhases(id);
    });

    runReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }
      editMsg.textContent = `Lanzando revisión #${id}...`;
      const response = await fetch(`${apiBase}/api/reviews/${id}/run`, { method: 'POST' });
      if (!response.ok) {
        editMsg.textContent = `No se pudo lanzar la revisión #${id}.`;
        return;
      }
      editMsg.textContent = `Revisión #${id} lanzada en background.`;
      await loadPhases(id);
    });

    clearFormBtn.addEventListener('click', () => {
      editId.value = '';
      editCandidateName.value = '';
      editGithubUrl.value = '';
      editDeployUrl.value = '';
      editExerciseName.value = '';
      editReviewerName.value = '';
      editReviewerEmail.value = '';
      editReviewedAt.value = '';
      editStatus.value = 'pending';
      editRecommendation.value = 'pendiente';
      editScores.value = '';
      editIntakeConclusions.value = '';
      editPredefinedQuestions.value = '';
      editOtherQuestions.value = '';
      editGoodPractices.value = '';
      editDesignPatterns.value = '';
      editReport.value = '';
      editMsg.textContent = '';
      phaseList.textContent = 'Selecciona una revisión para ver fases.';
      const url = new URL(window.location.href);
      url.searchParams.delete('id');
      window.history.replaceState(null, '', url.toString());
    });

    const params = new URLSearchParams(window.location.search);
    const initialId = Number(params.get('id'));
    if (initialId) {
      editId.value = String(initialId);
      loadReview(initialId);
    }
  </script>
</AppLayout>
