---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout activeNav="detail" title="Detalle de revisión" description="Actualiza una revisión y consulta el resultado por fases">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="grid grid-cols-1 gap-3 md:grid-cols-[220px_auto]">
      <label class="block text-xs font-medium text-slate-700" for="edit-id">ID revisión
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-id" type="number" min="1" placeholder="Ej. 25" />
      </label>
      <div class="flex items-end">
        <button class="w-fit rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-800" id="load-review" type="button">Cargar revisión</button>
      </div>
    </div>

    <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
      <label class="block text-xs font-medium text-slate-700" for="edit-candidate-name">Candidato
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-candidate-name" placeholder="Nombre y apellidos" />
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-github-url">URL repositorio
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-github-url" placeholder="https://github.com/usuario/repo" />
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-deploy-url">URL despliegue
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-deploy-url" placeholder="https://..." />
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-exercise-name">Ejercicio
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-exercise-name" placeholder="Ej. Memory" />
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-reviewer-name">Evaluador
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-reviewer-name" placeholder="Nombre evaluador" />
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-reviewer-email">Email evaluador
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-reviewer-email" placeholder="nombre@empresa.com" />
      </label>
      <label class="block text-xs font-medium text-slate-700 md:col-span-2" for="edit-reviewed-at">Fecha de revisión
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-reviewed-at" type="datetime-local" />
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-status">Estado
        <select class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-status">
          <option value="pending">pending</option>
          <option value="running">running</option>
          <option value="done">done</option>
          <option value="failed">failed</option>
          <option value="cancelled">cancelled</option>
        </select>
      </label>
      <label class="block text-xs font-medium text-slate-700" for="edit-recommendation">Recomendación
        <select class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-recommendation">
          <option value="pendiente">pendiente</option>
          <option value="apto">apto</option>
          <option value="no_apto">no_apto</option>
        </select>
      </label>
      <label class="block text-xs font-medium text-slate-700 md:col-span-2" for="edit-scores">Scores (JSON)
        <input class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm md:col-span-2" id="edit-scores" placeholder='{"arquitectura": 8, "tests": 7}' />
      </label>
    </div>

    <label class="mt-3 block text-xs font-medium text-slate-700" for="edit-intake-conclusions">Conclusiones
      <textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-intake-conclusions" placeholder="Resumen final de la valoración"></textarea>
    </label>
    <label class="mt-3 block text-xs font-medium text-slate-700" for="edit-predefined-questions">Preguntas predefinidas
      <textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-predefined-questions" placeholder="Una pregunta por línea"></textarea>
    </label>
    <label class="mt-3 block text-xs font-medium text-slate-700" for="edit-other-questions">Otras preguntas para entrevista
      <textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-other-questions" placeholder="Preguntas adicionales"></textarea>
    </label>
    <label class="mt-3 block text-xs font-medium text-slate-700" for="edit-good-practices">Buenas prácticas
      <textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-good-practices" placeholder="Notas de buenas prácticas detectadas"></textarea>
    </label>
    <label class="mt-3 block text-xs font-medium text-slate-700" for="edit-design-patterns">Patrones de diseño y arquitectura
      <textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-design-patterns" placeholder="Observaciones de diseño/arquitectura"></textarea>
    </label>
    <label class="mt-3 block text-xs font-medium text-slate-700" for="edit-report">Informe final
      <textarea class="mt-1 min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="edit-report" placeholder="Resultado final de la revisión"></textarea>
    </label>
    <div class="mt-3 flex flex-wrap gap-2">
      <button class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white" id="save-review" type="button">Guardar cambios</button>
      <button class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-800" id="run-review" type="button">Run IA</button>
      <button class="rounded-lg bg-rose-700 px-4 py-2 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-60" id="stop-review" type="button" disabled>Stop IA</button>
      <button class="rounded-lg bg-rose-700 px-4 py-2 text-sm font-medium text-white" id="clear-form" type="button">Limpiar</button>
    </div>
    <p class="mt-2 text-xs text-slate-500" id="edit-msg"></p>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-sm font-semibold text-slate-900">Fases revisadas</h3>
      <button class="rounded-lg bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700" id="refresh-live" type="button">Refrescar ahora</button>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-slate-200 px-2 py-0.5 font-semibold text-slate-700" id="run-state-badge">Estado: -</span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600" id="run-progress">Progreso: -</span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600" id="run-elapsed">Tiempo ejecución: -</span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600" id="run-timeout-signal">Timeout fase: -</span>
      <span class="text-slate-500" id="run-updated-at">Última actualización: -</span>
    </div>
    <div class="mt-2 text-xs">
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600" id="run-optimization-hint">Optimización: -</span>
    </div>
    <div class="mt-2 text-xs text-slate-500" id="phase-list">Selecciona una revisión para ver fases.</div>
  </section>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;

    const editId = document.getElementById('edit-id');
    const loadReviewBtn = document.getElementById('load-review');
    const editCandidateName = document.getElementById('edit-candidate-name');
    const editGithubUrl = document.getElementById('edit-github-url');
    const editDeployUrl = document.getElementById('edit-deploy-url');
    const editExerciseName = document.getElementById('edit-exercise-name');
    const editReviewerName = document.getElementById('edit-reviewer-name');
    const editReviewerEmail = document.getElementById('edit-reviewer-email');
    const editReviewedAt = document.getElementById('edit-reviewed-at');
    const editStatus = document.getElementById('edit-status');
    const editRecommendation = document.getElementById('edit-recommendation');
    const editScores = document.getElementById('edit-scores');
    const editIntakeConclusions = document.getElementById('edit-intake-conclusions');
    const editPredefinedQuestions = document.getElementById('edit-predefined-questions');
    const editOtherQuestions = document.getElementById('edit-other-questions');
    const editGoodPractices = document.getElementById('edit-good-practices');
    const editDesignPatterns = document.getElementById('edit-design-patterns');
    const editReport = document.getElementById('edit-report');
    const saveReviewBtn = document.getElementById('save-review');
    const runReviewBtn = document.getElementById('run-review');
    const stopReviewBtn = document.getElementById('stop-review');
    const clearFormBtn = document.getElementById('clear-form');
    const editMsg = document.getElementById('edit-msg');
    const phaseList = document.getElementById('phase-list');
    const refreshLiveBtn = document.getElementById('refresh-live');
    const runStateBadge = document.getElementById('run-state-badge');
    const runProgress = document.getElementById('run-progress');
    const runElapsed = document.getElementById('run-elapsed');
    const runTimeoutSignal = document.getElementById('run-timeout-signal');
    const runOptimizationHint = document.getElementById('run-optimization-hint');
    const runUpdatedAt = document.getElementById('run-updated-at');

    const POLL_INTERVAL_MS = 3000;
    const LIVE_TIMER_INTERVAL_MS = 1000;
    const PHASE_TIMEOUT_MS_FALLBACK = 420000;
    let pollTimer = null;
    let liveTimer = null;
    let currentPollingId = null;
    let activeSkillCountPromise = null;
    let latestRunSnapshot = null;
    let runtimePhaseTimeoutMs = PHASE_TIMEOUT_MS_FALLBACK;

    function statusBadgeClass(status) {
      if (status === 'running') return 'rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-800';
      if (status === 'done') return 'rounded-full bg-emerald-100 px-2 py-0.5 font-semibold text-emerald-800';
      if (status === 'failed') return 'rounded-full bg-rose-100 px-2 py-0.5 font-semibold text-rose-800';
      if (status === 'cancelled') return 'rounded-full bg-indigo-100 px-2 py-0.5 font-semibold text-indigo-800';
      return 'rounded-full bg-slate-200 px-2 py-0.5 font-semibold text-slate-700';
    }

    function setUpdatedNow() {
      runUpdatedAt.textContent = `Última actualización: ${new Date().toLocaleTimeString()}`;
    }

    function setRunButtonDisabled(disabled, label = null) {
      runReviewBtn.disabled = disabled;
      runReviewBtn.classList.toggle('cursor-not-allowed', disabled);
      runReviewBtn.classList.toggle('opacity-70', disabled);
      if (label) runReviewBtn.textContent = label;
      else runReviewBtn.textContent = 'Run IA';
    }

    async function getActiveSkillCount() {
      if (!activeSkillCountPromise) {
        activeSkillCountPromise = fetch(`${apiBase}/api/skills`)
          .then((response) => (response.ok ? response.json() : []))
          .then((skills) => (Array.isArray(skills) ? skills.length : 0))
          .catch(() => 0);
      }
      return activeSkillCountPromise;
    }

    async function loadRuntimeConfig() {
      try {
        const response = await fetch(`${apiBase}/api/runtime-config`);
        if (!response.ok) return;
        const config = await response.json();
        const timeout = Number(config?.codexCliTimeoutMs);
        if (Number.isFinite(timeout) && timeout > 0) {
          runtimePhaseTimeoutMs = timeout;
        }
      } catch {
        runtimePhaseTimeoutMs = PHASE_TIMEOUT_MS_FALLBACK;
      }
    }

    function stopPolling() {
      if (pollTimer) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
      if (liveTimer) {
        clearInterval(liveTimer);
        liveTimer = null;
      }
      currentPollingId = null;
      latestRunSnapshot = null;
    }

    function startPolling(id) {
      if (currentPollingId === id && pollTimer) return;
      stopPolling();
      currentPollingId = id;
      pollTimer = window.setInterval(() => {
        void refreshLive(id, { silent: true });
      }, POLL_INTERVAL_MS);
      if (!liveTimer) {
        liveTimer = window.setInterval(() => {
          updateLiveRuntimeIndicators();
        }, LIVE_TIMER_INTERVAL_MS);
      }
    }

    function formatDuration(ms) {
      if (!Number.isFinite(ms) || ms < 0) return '0s';
      const totalSeconds = Math.floor(ms / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      if (minutes === 0) return `${seconds}s`;
      return `${minutes}m ${String(seconds).padStart(2, '0')}s`;
    }

    function getPhaseTimeoutStatus(remainingMs) {
      if (remainingMs <= 0) {
        return {
          className: 'rounded-full bg-rose-100 px-2 py-0.5 font-semibold text-rose-800',
          label: `Timeout fase: superado hace ${formatDuration(Math.abs(remainingMs))}`
        };
      }
      if (remainingMs <= 30000) {
        return {
          className: 'rounded-full bg-rose-100 px-2 py-0.5 font-semibold text-rose-800',
          label: `Timeout fase: crítico (${formatDuration(remainingMs)} restante)`
        };
      }
      if (remainingMs <= 120000) {
        return {
          className: 'rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-800',
          label: `Timeout fase: aviso (${formatDuration(remainingMs)} restante)`
        };
      }
      return {
        className: 'rounded-full bg-emerald-100 px-2 py-0.5 font-semibold text-emerald-800',
        label: `Timeout fase: OK (${formatDuration(remainingMs)} restante)`
      };
    }

    function updateLiveRuntimeIndicators() {
      if (!latestRunSnapshot || latestRunSnapshot.status !== 'running') return;
      const now = Date.now();
      const reviewElapsedMs = now - latestRunSnapshot.reviewStartedAtMs;
      runElapsed.textContent = `Tiempo ejecución: ${formatDuration(reviewElapsedMs)}`;

      const currentPhaseStartMs = latestRunSnapshot.currentPhaseStartedAtMs || latestRunSnapshot.reviewStartedAtMs;
      const phaseElapsedMs = now - currentPhaseStartMs;
      const remainingMs = runtimePhaseTimeoutMs - phaseElapsedMs;
      const timeoutStatus = getPhaseTimeoutStatus(remainingMs);
      runTimeoutSignal.className = timeoutStatus.className;
      runTimeoutSignal.textContent = timeoutStatus.label;
    }

    function updateOptimizationHint(phases) {
      if (!Array.isArray(phases) || phases.length === 0) {
        runOptimizationHint.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
        runOptimizationHint.textContent = 'Optimización: sin datos de fases todavía.';
        return;
      }

      const now = Date.now();
      let slowestPhase = null;
      let slowestRatio = 0;

      for (const phase of phases) {
        const startedAt = phase.started_at ? new Date(phase.started_at).getTime() : null;
        if (!startedAt || Number.isNaN(startedAt)) continue;
        const finishedAt = phase.finished_at ? new Date(phase.finished_at).getTime() : now;
        const durationMs = Math.max(0, finishedAt - startedAt);
        const ratio = durationMs / runtimePhaseTimeoutMs;
        if (ratio > slowestRatio) {
          slowestRatio = ratio;
          slowestPhase = phase.phase_key;
        }
      }

      if (!slowestPhase) {
        runOptimizationHint.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
        runOptimizationHint.textContent = 'Optimización: sin tiempos válidos de fase.';
        return;
      }

      if (slowestRatio >= 0.9) {
        runOptimizationHint.className = 'rounded-full bg-rose-100 px-2 py-0.5 font-semibold text-rose-800';
        runOptimizationHint.textContent = `Optimización: urgente dividir "${slowestPhase}" (usa ${(slowestRatio * 100).toFixed(0)}% del timeout).`;
        return;
      }

      if (slowestRatio >= 0.7) {
        runOptimizationHint.className = 'rounded-full bg-amber-100 px-2 py-0.5 font-semibold text-amber-800';
        runOptimizationHint.textContent = `Optimización: conviene dividir "${slowestPhase}" (usa ${(slowestRatio * 100).toFixed(0)}% del timeout).`;
        return;
      }

      runOptimizationHint.className = 'rounded-full bg-emerald-100 px-2 py-0.5 font-semibold text-emerald-800';
      runOptimizationHint.textContent = `Optimización: tiempos de fase saludables (máximo ${(slowestRatio * 100).toFixed(0)}% del timeout).`;
    }

    function updateRunSnapshot(detail, phases) {
      if (detail.status !== 'running') {
        latestRunSnapshot = null;
        runElapsed.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
        runElapsed.textContent = 'Tiempo ejecución: -';
        runTimeoutSignal.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
        runTimeoutSignal.textContent = 'Timeout fase: -';
        return;
      }

      const reviewStartedAtMs = detail.started_at ? new Date(detail.started_at).getTime() : Date.now();
      const runningPhase = phases.find((phase) => phase.status === 'running');
      const currentPhaseStartedAtMs = runningPhase?.started_at ? new Date(runningPhase.started_at).getTime() : null;
      latestRunSnapshot = { status: detail.status, reviewStartedAtMs, currentPhaseStartedAtMs };
      updateLiveRuntimeIndicators();
    }

    async function loadPhases(id) {
      phaseList.textContent = 'Cargando fases...';
      try {
        const response = await fetch(`${apiBase}/api/reviews/${id}/phases`);
        if (!response.ok) throw new Error('No se pudieron cargar fases');
        const phases = await response.json();
        const expectedTotal = await getActiveSkillCount();
        const finished = phases.filter((phase) => phase.status === 'done' || phase.status === 'failed').length;
        runProgress.textContent = `Progreso: ${finished}/${Math.max(expectedTotal, phases.length)} fases`;

        if (!phases.length) {
          phaseList.textContent = 'Sin fases registradas todavía.';
          return;
        }

        phaseList.innerHTML = phases.map((phase) => {
          const startedAt = phase.started_at ? new Date(phase.started_at).getTime() : null;
          const finishedAt = phase.finished_at ? new Date(phase.finished_at).getTime() : null;
          const phaseDuration = startedAt ? formatDuration((finishedAt || Date.now()) - startedAt) : '-';
          return `
          <div class="mb-2 rounded-lg border border-slate-200 bg-slate-50 p-3">
            <div class="text-sm font-semibold text-slate-900">${phase.phase_key} · <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-normal">${phase.status}</span> · score: ${phase.score ?? '-'}</div>
            <div class="mt-1 text-[11px] text-slate-500">Duración fase: ${phaseDuration}</div>
            <div class="mt-1 text-xs text-slate-600">${phase.summary || '-'}</div>
          </div>
        `;
        }).join('');
      } catch {
        runProgress.textContent = 'Progreso: error cargando fases';
        phaseList.textContent = 'Error cargando fases.';
      }
    }

    function applyReviewDetail(detail, mode = 'full') {
      editId.value = String(detail.id);
      editStatus.value = detail.status;
      editRecommendation.value = detail.recommendation;
      editScores.value = detail.scores ? JSON.stringify(detail.scores) : '';
      editReport.value = detail.final_report || '';
      runStateBadge.className = statusBadgeClass(detail.status);
      runStateBadge.textContent = `Estado: ${detail.status || '-'}`;
      setRunButtonDisabled(detail.status === 'running', detail.status === 'running' ? 'En progreso' : 'Run IA');
      stopReviewBtn.disabled = detail.status !== 'running';

      if (mode === 'runtime') return;

      editCandidateName.value = detail.candidate_name || '';
      editGithubUrl.value = detail.github_url || '';
      editDeployUrl.value = detail.candidate_deploy_url || '';
      editExerciseName.value = detail.exercise_name || '';
      editReviewerName.value = detail.reviewer_name || '';
      editReviewerEmail.value = detail.reviewer_email || '';
      editReviewedAt.value = detail.reviewed_at ? new Date(detail.reviewed_at).toISOString().slice(0, 16) : '';
      editIntakeConclusions.value = detail.intake_conclusions || '';
      editPredefinedQuestions.value = Array.isArray(detail.predefined_questions) ? detail.predefined_questions.join('\n') : '';
      editOtherQuestions.value = detail.intake_other_questions || '';
      editGoodPractices.value = detail.intake_good_practices || '';
      editDesignPatterns.value = detail.intake_design_patterns || '';
    }

    async function refreshLive(id, options = { silent: false }) {
      if (!options.silent) editMsg.textContent = `Cargando revisión #${id}...`;

      const [reviewRes, phasesRes] = await Promise.all([
        fetch(`${apiBase}/api/reviews/${id}`),
        fetch(`${apiBase}/api/reviews/${id}/phases`)
      ]);

      if (!reviewRes.ok) throw new Error(`No se encontró la revisión #${id}.`);
      if (!phasesRes.ok) throw new Error('No se pudieron cargar fases.');

      const detail = await reviewRes.json();
      const phases = await phasesRes.json();

      applyReviewDetail(detail, options.silent ? 'runtime' : 'full');
      updateRunSnapshot(detail, phases);
      updateOptimizationHint(phases);

      const expectedTotal = await getActiveSkillCount();
      const finished = phases.filter((phase) => phase.status === 'done' || phase.status === 'failed').length;
      runProgress.textContent = `Progreso: ${finished}/${Math.max(expectedTotal, phases.length)} fases`;

      if (!phases.length) {
        phaseList.textContent = 'Sin fases registradas todavía.';
      } else {
        phaseList.innerHTML = phases.map((phase) => {
          const startedAt = phase.started_at ? new Date(phase.started_at).getTime() : null;
          const finishedAt = phase.finished_at ? new Date(phase.finished_at).getTime() : null;
          const phaseDuration = startedAt ? formatDuration((finishedAt || Date.now()) - startedAt) : '-';
          return `
          <div class="mb-2 rounded-lg border border-slate-200 bg-slate-50 p-3">
            <div class="text-sm font-semibold text-slate-900">${phase.phase_key} · <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-normal">${phase.status}</span> · score: ${phase.score ?? '-'}</div>
            <div class="mt-1 text-[11px] text-slate-500">Duración fase: ${phaseDuration}</div>
            <div class="mt-1 text-xs text-slate-600">${phase.summary || '-'}</div>
          </div>
        `;
        }).join('');
      }

      setUpdatedNow();
      if (detail.status === 'running') startPolling(id);
      else stopPolling();

      return detail;
    }

    async function loadReview(id) {
      try {
        const detail = await refreshLive(id, { silent: false });
        editMsg.textContent = detail.status === 'running'
          ? `Revisión #${id} en ejecución. Actualización automática activa.`
          : `Revisión #${id} cargada.`;
      } catch (error) {
        stopPolling();
        const message = error instanceof Error ? error.message : `No se encontró la revisión #${id}.`;
        editMsg.textContent = message;
        return;
      }

      await loadPhases(id);
      const url = new URL(window.location.href);
      url.searchParams.set('id', String(id));
      window.history.replaceState(null, '', url.toString());
    }

    loadReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }
      await loadReview(id);
    });

    saveReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }

      let parsedScores = null;
      if (editScores.value.trim()) {
        try {
          parsedScores = JSON.parse(editScores.value);
        } catch {
          editMsg.textContent = 'Scores no es JSON válido.';
          return;
        }
      }

      editMsg.textContent = 'Guardando cambios...';
      const response = await fetch(`${apiBase}/api/reviews/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          candidateName: editCandidateName.value.trim(),
          githubUrl: editGithubUrl.value.trim(),
          deployUrl: editDeployUrl.value.trim(),
          exerciseName: editExerciseName.value.trim(),
          reviewerName: editReviewerName.value.trim(),
          reviewerEmail: editReviewerEmail.value.trim(),
          reviewedAt: editReviewedAt.value.trim(),
          intakeConclusions: editIntakeConclusions.value.trim(),
          predefinedQuestions: editPredefinedQuestions.value
            .split('\n')
            .map((line) => line.trim())
            .filter(Boolean),
          intakeOtherQuestions: editOtherQuestions.value.trim(),
          intakeGoodPractices: editGoodPractices.value.trim(),
          intakeDesignPatterns: editDesignPatterns.value.trim(),
          status: editStatus.value,
          recommendation: editRecommendation.value,
          scores: parsedScores,
          finalReport: editReport.value
        })
      });

      if (!response.ok) {
        editMsg.textContent = 'No se pudo actualizar la revisión.';
        return;
      }

      editMsg.textContent = `Revisión #${id} actualizada.`;
      await loadPhases(id);
    });

    runReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }
      if (editStatus.value === 'running' || runReviewBtn.disabled) {
        editMsg.textContent = `La revisión #${id} ya está en ejecución.`;
        return;
      }
      setRunButtonDisabled(true, 'En progreso');
      editMsg.textContent = `Lanzando revisión #${id}...`;
      const response = await fetch(`${apiBase}/api/reviews/${id}/run`, { method: 'POST' });
      if (!response.ok) {
        if (response.status === 409) {
          try {
            const body = await response.json();
            editMsg.textContent = body?.error || 'Solo se permite una revisión IA en ejecución a la vez.';
          } catch {
            editMsg.textContent = 'Solo se permite una revisión IA en ejecución a la vez.';
          }
        } else {
          editMsg.textContent = `No se pudo lanzar la revisión #${id}.`;
        }
        setRunButtonDisabled(editStatus.value === 'running', editStatus.value === 'running' ? 'En progreso' : 'Run IA');
        return;
      }

      editMsg.textContent = `Revisión #${id} lanzada. Siguiendo progreso en tiempo real...`;
      startPolling(id);
      await refreshLive(id, { silent: true });
    });

    stopReviewBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }
      if (editStatus.value !== 'running') {
        editMsg.textContent = `La revisión #${id} no está en ejecución.`;
        return;
      }
      const confirmed = window.confirm(`¿Parar la revisión IA #${id}?`);
      if (!confirmed) return;
      stopReviewBtn.disabled = true;
      editMsg.textContent = `Parando revisión #${id}...`;
      const response = await fetch(`${apiBase}/api/reviews/${id}/stop`, { method: 'POST' });
      if (!response.ok) {
        let errorText = `No se pudo parar la revisión #${id}.`;
        try {
          const body = await response.json();
          errorText = body?.error || errorText;
        } catch {}
        editMsg.textContent = errorText;
        stopReviewBtn.disabled = false;
        return;
      }
      editMsg.textContent = `Revisión #${id} detenida por usuario.`;
      await refreshLive(id, { silent: true });
    });

    clearFormBtn.addEventListener('click', () => {
      stopPolling();
      editId.value = '';
      editCandidateName.value = '';
      editGithubUrl.value = '';
      editDeployUrl.value = '';
      editExerciseName.value = '';
      editReviewerName.value = '';
      editReviewerEmail.value = '';
      editReviewedAt.value = '';
      editStatus.value = 'pending';
      editRecommendation.value = 'pendiente';
      editScores.value = '';
      editIntakeConclusions.value = '';
      editPredefinedQuestions.value = '';
      editOtherQuestions.value = '';
      editGoodPractices.value = '';
      editDesignPatterns.value = '';
      editReport.value = '';
      editMsg.textContent = '';
      setRunButtonDisabled(false, 'Run IA');
      stopReviewBtn.disabled = true;
      runStateBadge.className = statusBadgeClass(null);
      runStateBadge.textContent = 'Estado: -';
      runProgress.textContent = 'Progreso: -';
      runElapsed.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
      runElapsed.textContent = 'Tiempo ejecución: -';
      runTimeoutSignal.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
      runTimeoutSignal.textContent = 'Timeout fase: -';
      runOptimizationHint.className = 'rounded-full bg-slate-100 px-2 py-0.5 text-slate-600';
      runOptimizationHint.textContent = 'Optimización: -';
      runUpdatedAt.textContent = 'Última actualización: -';
      phaseList.textContent = 'Selecciona una revisión para ver fases.';
      const url = new URL(window.location.href);
      url.searchParams.delete('id');
      window.history.replaceState(null, '', url.toString());
    });

    refreshLiveBtn.addEventListener('click', async () => {
      const id = Number(editId.value);
      if (!id) {
        editMsg.textContent = 'Indica un ID válido.';
        return;
      }

      try {
        await refreshLive(id, { silent: false });
        editMsg.textContent = `Revisión #${id} actualizada manualmente.`;
      } catch {
        editMsg.textContent = `No se pudo actualizar la revisión #${id}.`;
      }
    });

    const params = new URLSearchParams(window.location.search);
    const initialId = Number(params.get('id'));
    void loadRuntimeConfig();
    if (initialId) {
      editId.value = String(initialId);
      loadReview(initialId);
    }
  </script>
</AppLayout>
