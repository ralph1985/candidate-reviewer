---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout activeNav="home" title="Inicio" description="Resumen rápido y accesos directos del flujo de revisión">
  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <h3 class="text-base font-semibold text-slate-900">Estado del sistema</h3>
    <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-3">
      <article class="rounded-lg border border-slate-200 bg-slate-50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">Total revisiones</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900" id="kpi-total">-</p>
      </article>
      <article class="rounded-lg border border-slate-200 bg-slate-50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">Running</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900" id="kpi-running">-</p>
      </article>
      <article class="rounded-lg border border-slate-200 bg-slate-50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">Skills activas</p>
        <p class="mt-1 text-2xl font-semibold text-slate-900" id="kpi-skills">-</p>
      </article>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-4">
    <h3 class="text-base font-semibold text-slate-900">Accesos directos</h3>
    <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-3">
      <a class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-800 hover:bg-slate-100" data-app-route="/reviews/new" href="/reviews/new">
        Crear nueva revisión
      </a>
      <a class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-800 hover:bg-slate-100" data-app-route="/reviews" href="/reviews">
        Ver listado de revisiones
      </a>
      <a class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-800 hover:bg-slate-100" data-app-route="/skills" href="/skills">
        Administrar skills
      </a>
    </div>
    <p class="mt-3 text-xs text-slate-500" id="home-msg"></p>
  </section>

  <script type="module">
    const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
    const apiBase = appBase;
    const routeLinks = Array.from(document.querySelectorAll('a[data-app-route]'));
    for (const link of routeLinks) {
      const route = link.getAttribute('data-app-route') || '/';
      link.setAttribute('href', `${appBase}${route}`);
    }

    const totalEl = document.getElementById('kpi-total');
    const runningEl = document.getElementById('kpi-running');
    const skillsEl = document.getElementById('kpi-skills');
    const msgEl = document.getElementById('home-msg');

    async function loadKpis() {
      msgEl.textContent = 'Cargando métricas...';
      try {
        const [reviewsRes, skillsRes] = await Promise.all([
          fetch(`${apiBase}/api/reviews`),
          fetch(`${apiBase}/api/skills`)
        ]);
        if (!reviewsRes.ok || !skillsRes.ok) throw new Error('No se pudieron cargar métricas');
        const reviews = await reviewsRes.json();
        const skills = await skillsRes.json();

        totalEl.textContent = String(reviews.length);
        runningEl.textContent = String(reviews.filter((item) => item.status === 'running').length);
        skillsEl.textContent = String(skills.filter((item) => item.active).length);
        msgEl.textContent = '';
      } catch {
        msgEl.textContent = 'No se pudieron cargar las métricas.';
      }
    }

    loadKpis();
  </script>
</AppLayout>

