---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'new' | 'reviews' | 'detail' | 'skills';
}

const { title, description = 'Gestión de revisiones técnicas por fases', activeNav = 'home' } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Candidate Reviewer</title>
  </head>
  <body class="bg-[radial-gradient(1200px_420px_at_20%_-45%,#dbeafe_0%,transparent_60%),linear-gradient(180deg,#f8fafc_0%,#f1f5f9_100%)] text-slate-900">
    <button
      class="fixed left-4 top-4 z-30 inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white/90 px-3 py-2 text-xs font-semibold text-slate-800 shadow-sm backdrop-blur lg:hidden"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="app-sidebar"
    >
      <span class="text-sm leading-none">☰</span>
      <span id="menu-toggle-label">Menú</span>
    </button>
    <div class="fixed inset-0 z-20 hidden bg-slate-950/30 backdrop-blur-[1px] lg:hidden" id="menu-backdrop"></div>

    <main class="mx-auto grid min-h-screen max-w-[1400px] grid-cols-1 gap-6 p-4 pt-20 lg:grid-cols-[300px_1fr] lg:p-6 lg:pt-6">
      <aside
        class="fixed inset-y-0 left-0 z-30 w-80 -translate-x-full border-r border-slate-200 bg-white/95 p-5 shadow-2xl backdrop-blur transition-transform duration-300 ease-out lg:sticky lg:top-4 lg:h-[calc(100vh-2rem)] lg:w-auto lg:translate-x-0 lg:rounded-2xl lg:border lg:shadow-sm"
        id="app-sidebar"
      >
        <div>
          <h1 class="text-xl font-semibold tracking-tight text-slate-900">Candidate Reviewer</h1>
          <p class="mt-1 text-sm text-slate-500">Revisión técnica por fases con IA</p>
        </div>

        <nav class="mt-6 grid gap-2">
          <a class="menu-link rounded-xl border px-4 py-3 text-left transition-colors" data-active={activeNav === 'home'} data-app-route="/" href="/">
            <span class="block text-sm font-semibold">Inicio</span>
            <span class="block text-xs text-inherit/70">Panel general</span>
          </a>
          <a class="menu-link rounded-xl border px-4 py-3 text-left transition-colors" data-active={activeNav === 'new'} data-app-route="/reviews/new" href="/reviews/new">
            <span class="block text-sm font-semibold">Nueva revisión</span>
            <span class="block text-xs text-inherit/70">Alta de candidato</span>
          </a>
          <a class="menu-link rounded-xl border px-4 py-3 text-left transition-colors" data-active={activeNav === 'reviews'} data-app-route="/reviews" href="/reviews">
            <span class="block text-sm font-semibold">Revisiones</span>
            <span class="block text-xs text-inherit/70">Listado y ejecución</span>
          </a>
          <a class="menu-link rounded-xl border px-4 py-3 text-left transition-colors" data-active={activeNav === 'detail'} data-app-route="/reviews/detail" href="/reviews/detail">
            <span class="block text-sm font-semibold">Detalle</span>
            <span class="block text-xs text-inherit/70">Estado, informe y fases</span>
          </a>
          <a class="menu-link rounded-xl border px-4 py-3 text-left transition-colors" data-active={activeNav === 'skills'} data-app-route="/skills" href="/skills">
            <span class="block text-sm font-semibold">Skills</span>
            <span class="block text-xs text-inherit/70">Prompts y orden</span>
          </a>
        </nav>
      </aside>

      <div class="min-w-0 space-y-4 lg:pl-2">
        <header class="rounded-xl border border-slate-200 bg-white/85 p-4 backdrop-blur">
          <h2 class="text-lg font-semibold tracking-tight text-slate-900">{title}</h2>
          <p class="mt-1 text-sm text-slate-500">{description}</p>
        </header>
        <slot />
      </div>
    </main>

    <script type="module">
      const mobileMedia = window.matchMedia('(max-width: 1023px)');
      const menuToggleBtn = document.getElementById('menu-toggle');
      const menuToggleLabel = document.getElementById('menu-toggle-label');
      const menuBackdrop = document.getElementById('menu-backdrop');
      const sidebar = document.getElementById('app-sidebar');
      const navLinks = Array.from(document.querySelectorAll('a[data-app-route]'));

      const appBase = window.location.pathname.startsWith('/cr/') ? '/cr' : '';
      const activeClasses = ['border-blue-700', 'bg-blue-700', 'text-white', 'shadow-sm'];
      const inactiveClasses = ['border-slate-200', 'bg-white', 'text-slate-700', 'hover:bg-slate-50'];

      for (const link of navLinks) {
        const route = link.getAttribute('data-app-route') || '/';
        link.setAttribute('href', `${appBase}${route}`);

        link.classList.remove(...activeClasses, ...inactiveClasses);
        if (link.getAttribute('data-active') === 'true') {
          link.classList.add(...activeClasses);
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.add(...inactiveClasses);
        }
      }

      function setMobileMenu(open) {
        if (!menuToggleBtn || !menuBackdrop || !sidebar) return;
        if (!mobileMedia.matches) {
          sidebar.classList.remove('-translate-x-full');
          menuBackdrop.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
          menuToggleBtn.setAttribute('aria-expanded', 'false');
          if (menuToggleLabel) menuToggleLabel.textContent = 'Menú';
          return;
        }
        sidebar.classList.toggle('-translate-x-full', !open);
        menuBackdrop.classList.toggle('hidden', !open);
        document.body.classList.toggle('overflow-hidden', open);
        menuToggleBtn.setAttribute('aria-expanded', String(open));
        if (menuToggleLabel) menuToggleLabel.textContent = open ? 'Cerrar' : 'Menú';
      }

      if (menuToggleBtn) {
        menuToggleBtn.addEventListener('click', () => {
          const isOpen = menuToggleBtn.getAttribute('aria-expanded') === 'true';
          setMobileMenu(!isOpen);
        });
      }
      if (menuBackdrop) {
        menuBackdrop.addEventListener('click', () => setMobileMenu(false));
      }
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMobileMenu(false);
      });
      mobileMedia.addEventListener('change', () => setMobileMenu(false));
      setMobileMenu(false);
    </script>
  </body>
</html>

