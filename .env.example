# API
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/candidate_reviewer

# Codex CLI phased reviewer
CODEX_CLI_ENABLED=false
CODEX_CLI_BIN=codex
CODEX_CLI_ARGS=exec
CODEX_CLI_TIMEOUT_MS=15000

# Review runtime
REVIEW_WORKSPACES_ROOT=/var/candidate-reviewer/workspaces
REVIEW_WORKSPACE_CLEANUP_AFTER_RUN=false
REVIEW_TEST_TIMEOUT_MS=300000
